{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aipf/v3.2/request.schema.json",
  "title": "AI Image Prompt Factory V3.2 Semantic Spec",
  "type": "object",
  "required": [
    "version",
    "request",
    "route",
    "locks",
    "references",
    "identity",
    "body_transformation",
    "historical",
    "art",
    "director",
    "output"
  ],
  "properties": {
    "version": {
      "enum": [
        "3.0",
        "3.1",
        "3.2"
      ]
    },
    "id": {
      "type": "string"
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "enum": [
        "new_generation",
        "reference_transform",
        "historical_portrait",
        "artifact_transform",
        "art_style_transform",
        "storyboard_or_grid",
        "design_layout",
        "evaluation_revision"
      ]
    },
    "locks": {
      "type": "object",
      "additionalProperties": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "roles"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "enum": [
                "identity",
                "pose",
                "outfit",
                "hairstyle",
                "artifact",
                "style",
                "environment",
                "layout",
                "palette"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "strict_identity",
            "recognizable_identity",
            "identity_inspired",
            "identity_unlocked"
          ]
        },
        "locked_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "body_transformation": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "preserve",
            "presentation_only",
            "creative_transformation",
            "plausible_fitness_projection",
            "artistic_stylization"
          ]
        },
        "anatomy_change": {
          "type": "string"
        },
        "pose_change": {
          "type": "string"
        },
        "camera_presentation": {
          "type": "string"
        },
        "garment_shaping": {
          "type": "string"
        },
        "artistic_stylization": {
          "type": "string"
        }
      }
    },
    "historical": {
      "type": "object",
      "required": [
        "strictness",
        "packs"
      ],
      "properties": {
        "strictness": {
          "enum": [
            "strict_reconstruction",
            "historically_informed",
            "period_drama",
            "fantasy_hybrid"
          ]
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subperiod": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "occasion": {
          "type": [
            "string",
            "null"
          ]
        },
        "intentional_hybrids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "art": {
      "type": "object",
      "required": [
        "method",
        "artifact_form",
        "artifact_state"
      ],
      "properties": {
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_form": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "requested_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "director": {
      "type": "object",
      "properties": {
        "moment": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "gaze": {
          "type": "string"
        },
        "body_weight": {
          "type": "string"
        },
        "hand_logic": {
          "type": "string"
        },
        "fabric_response": {
          "type": "string"
        },
        "prop_interaction": {
          "type": "string"
        },
        "foreground": {
          "type": "string"
        },
        "midground": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "light_source": {
          "type": "string"
        },
        "material_response": {
          "type": "string"
        },
        "micro_story": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "profile",
        "aspect_ratio"
      ],
      "properties": {
        "profile": {
          "enum": [
            "compact",
            "standard",
            "extended"
          ]
        },
        "aspect_ratio": {
          "type": "string"
        },
        "text_in_image": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generation_requested": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_claims": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "visual_patterns": {
      "type": "object",
      "properties": {
        "enable_validated": {
          "type": "boolean"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
