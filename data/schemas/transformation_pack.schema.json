{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIPF V3.4 TransformationPack",
  "type": "object",
  "required": ["id", "version", "source_representation", "target_representation", "representation_delta", "failure_modes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string"},
    "source_representation": {"const": "portrait"},
    "target_representation": {"enum": ["volumetric_sculpture", "architectural_mural", "relief_print", "decorated_artifact"]},
    "representation_delta": {
      "type": "object",
      "required": ["geometry", "depth", "surface_mapping"],
      "properties": {
        "geometry": {"type": "string", "minLength": 10},
        "depth": {"type": "string", "minLength": 10},
        "surface_mapping": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    },
    "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
