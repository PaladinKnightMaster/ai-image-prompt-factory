{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIPF V3.4 Visual Semantic Lexicon",
  "type": "object",
  "required": ["version", "concepts"],
  "properties": {
    "version": {"type": "string"},
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "preferred_term", "domain", "visible_gloss", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
          "version": {"type": "string"},
          "preferred_term": {"type": "string", "minLength": 2},
          "domain": {"enum": ["garment", "pose_composition", "material", "craft_process", "art_method", "artifact_form", "representation_detail"]},
          "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "retrieval_terms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "visible_gloss": {"type": "string", "minLength": 12},
          "visual_signature": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "avoid_realizations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "retrieval_scope": {
            "type": "object",
            "properties": {
              "pack_ids": {"type": "array", "items": {"type": "string"}},
              "subperiods": {"type": "array", "items": {"type": "string"}},
              "regions": {"type": "array", "items": {"type": "string"}},
              "roles": {"type": "array", "items": {"type": "string"}},
              "occasions": {"type": "array", "items": {"type": "string"}},
              "art_method_ids": {"type": "array", "items": {"type": "string"}},
              "artifact_form_ids": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "evidence_refs": {
            "type": "object",
            "properties": {
              "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            },
            "anyOf": [{"required": ["claim_ids"], "properties": {"claim_ids": {"minItems": 1}}}, {"required": ["source_ids"], "properties": {"source_ids": {"minItems": 1}}}],
            "additionalProperties": false
          },
          "coalesce_group": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
