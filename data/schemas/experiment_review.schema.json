{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aipf/v3.3/experiment_review.schema.json",
  "title": "AIPF Blind Experiment Review",
  "type": "object",
  "required": [
    "run_id",
    "experiment_id",
    "review_package_sha256",
    "mapping_commitment_sha256",
    "status",
    "created_at_utc",
    "score_scale",
    "evaluation_dimensions",
    "items"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"enum": ["R1", "R2"]},
    "reviewer_pseudonym": {"type": "string"},
    "attestations": {
      "type": "object",
      "properties": {
        "independent_reviewer": {"type": "boolean"},
        "individual_image_review": {"type": "boolean"},
        "treatment_blind_until_freeze": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "review_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {"enum": ["open", "frozen"]},
    "created_at_utc": {"type": "string", "minLength": 1},
    "frozen_at_utc": {"type": ["string", "null"]},
    "review_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "score_scale": {
      "type": "object",
      "required": ["min", "max", "higher_is_better"],
      "properties": {
        "min": {"const": 1},
        "max": {"const": 5},
        "higher_is_better": {"const": true}
      },
      "additionalProperties": false
    },
    "evaluation_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["review_id", "scores", "notes"],
        "properties": {
          "review_id": {
            "type": "string",
            "minLength": 4,
            "pattern": "^R[A-HJ-NP-Z2-9]+$"
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {"type": "null"},
                {"type": "integer", "minimum": 1, "maximum": 5}
              ]
            }
          },
          "diagnostics": {
            "type": "object",
            "properties": {
              "target_region_localization": {"enum": ["yes", "partial", "no", null]},
              "controlled_tonal_transition_visible": {"enum": ["yes", "partial", "no", null]},
              "integrated_with_flat_print_structure": {"enum": ["yes", "partial", "no", null]},
              "generic_global_or_3d_shading": {"enum": ["none", "ambiguous", "clear", null]},
              "airbrushed_or_overlay_like_gradient": {"enum": ["none", "ambiguous", "clear", null]}
            },
            "additionalProperties": false
          },
          "failure_observations": {
            "type": "object",
            "properties": {"target_gradation_materially_absent_or_generic": {"type": ["boolean", "null"]}},
            "additionalProperties": false
          },
          "failure_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
