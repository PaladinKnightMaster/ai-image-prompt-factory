{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "pack_type",
    "period",
    "region",
    "incompatible_or_anachronistic",
    "prompt_fragments",
    "sources"
  ],
  "properties": {
    "concept_refs": {
      "type": "object",
      "required": ["core", "conditional"],
      "properties": {
        "core": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "conditional": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  }
}
