{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aipf/v3.3/experiment_run.schema.json",
  "title": "AIPF Experiment Run",
  "type": "object",
  "required": [
    "run_id",
    "experiment_id",
    "experiment_version",
    "status",
    "generation_mode",
    "model",
    "model_snapshot",
    "settings",
    "variants"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_version": {"type": "string", "minLength": 1},
    "experiment_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at_utc": {"type": "string"},
    "status": {
      "enum": ["planned", "running", "completed", "partial", "failed"]
    },
    "generation_mode": {
      "enum": ["host_native", "api", "manual_import"]
    },
    "model": {"type": "string", "minLength": 1},
    "model_snapshot": {"type": "string", "minLength": 1},
    "settings": {
      "type": "object",
      "required": ["replicates", "size", "quality"],
      "properties": {
        "replicates": {"type": "integer", "minimum": 1},
        "size": {"type": "string", "minLength": 1},
        "quality": {"type": "string", "minLength": 1},
        "background": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "variant_id",
          "factor",
          "prompt",
          "prompt_sha256",
          "outputs"
        ],
        "properties": {
          "variant_id": {"type": "string", "minLength": 1},
          "factor": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "prompt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["replicate", "blind_id", "status"],
              "properties": {
                "replicate": {"type": "integer", "minimum": 1},
                "blind_id": {
                  "type": "string",
                  "minLength": 4,
                  "pattern": "^[A-Z2-9]+$"
                },
                "status": {
                  "enum": ["planned", "generated", "failed"]
                },
                "image": {"type": ["string", "null"]},
                "image_sha256": {
                  "anyOf": [
                    {"type": "null"},
                    {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  ]
                },
                "metadata": {"type": ["string", "null"]},
                "error": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
