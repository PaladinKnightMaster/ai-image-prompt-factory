{
  "name": "ai-image-prompt-factory",
  "version": "3.3.0",
  "category": "Image Prompt Engineering / Visual Direction",
  "description": "Evidence-backed GPT Image 2 prompt compiler and Empirical Lab with preregistered experiments, frozen fixtures, provenance-aware execution, controlled review, replication, transfer testing, and regression coverage.",
  "primary_output": "prompt",
  "primary_adapter": "gpt-image-2",
  "license": "MIT",
  "compat": [
    "chatgpt",
    "codex",
    "claude-code",
    "cursor",
    "gemini-cli",
    "opencode",
    "python-cli"
  ],
  "entrypoints": {
    "skill": "SKILL.md",
    "cli": "aipf",
    "validator": "python scripts/validate_repo.py",
    "gallery": "python website/generate_gallery.py",
    "regression": "aipf regress",
    "ingest": "aipf ingest",
    "evidence": "aipf evidence",
    "patterns": "aipf patterns",
    "experiments": "aipf experiment-inventory",
    "benchmarks": "aipf benchmark-report",
    "internal_gallery": "python internal-gallery/generate_gallery.py"
  }
}
